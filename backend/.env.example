# HomeSOS Environment Configuration
# Add your Google Gemini API Key below for live AI extraction and analysis
GEMINI_API_KEY=your_gemini_api_key_here
# If GEMINI_API_KEY is blank or invalid, HomeSOS automatically operates in rich offline Demo & Rule-based fallback mode
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./homesos.db
